# Runtime configuration for the Cloud Functions.
#
# HOW THIS REACHES PRODUCTION
# ---------------------------
# Do NOT create functions/.env by hand and deploy from your laptop. The GitHub
# Actions workflow writes functions/.env from repository secrets on every
# deploy, so CI is the single source of truth — otherwise the next merge to
# main redeploys the functions without these values and quietly switches off
# calling, texting and the calendar.
#
# To set one of these: GitHub → the repo → Settings → Secrets and variables →
# Actions → New repository secret, using exactly the names below. Then re-run
# the "Deploy Firestore rules + Storage rules + Cloud Functions" workflow (or
# merge anything that touches functions/).
#
# Everything here is optional. Each feature reports "not set up yet" until its
# own variables exist, so partial configuration is fine and expected.
#
# Note: these are plain runtime env vars, readable in the Google Cloud console
# by anyone with project access. That is a deliberate choice inherited from the
# Stripe/Twilio setup — it lets a deploy succeed before the values exist. The
# genuinely high-value keys (SendGrid, Anthropic, Stripe) use Secret Manager
# via defineSecret() instead and are not listed here.

# ── Telnyx: SMS (the live texting path) ─────────────────────────────────────
# Mission Control → API Keys. One bearer token for the whole v2 API.
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mission Control → Account Settings → Keys & Credentials → your account's
# PUBLIC key, base64. Webhooks are verified with Ed25519 against this; without
# it every Telnyx webhook is rejected, which is the intended fail-closed
# behaviour rather than a bug.
TELNYX_PUBLIC_KEY=
# The sending number, attached to an approved Sole Proprietor 10DLC campaign.
# Leave unset until the campaign is approved — unregistered A2P long-code
# traffic is blocked by every US carrier.
TELNYX_FROM_NUMBER=+14055550123
# Optional. Sends through a specific messaging profile instead of the number's
# default one.
TELNYX_MESSAGING_PROFILE_ID=

# ── Telnyx: Voice (browser softphone, cell bridge, inbound routing) ─────────
# A *Credentials* SIP connection: Mission Control → Voice → SIP Connections.
# WebRTC credentials hang off it, and its outbound voice profile is what
# authorises PSTN calls. Treat that profile as a security control, not billing:
# a browser holding a WebRTC credential can dial anywhere the profile permits,
# so set destination restrictions and a daily spend cap. See
# docs/telnyx-setup.md.
TELNYX_SIP_CONNECTION_ID=
# A TeXML application: Mission Control → Voice → TeXML Applications. Used for
# inbound routing and for cell-bridge calls. Optional — the browser softphone
# works without it.
TELNYX_TEXML_APP_ID=
# Outbound caller ID. Optional — falls back to TELNYX_FROM_NUMBER.
TELNYX_CALLER_ID=+14055550123

# ── Twilio: SMS (legacy; kept only until the voice path moves to Telnyx) ────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# The sending number. Leave unset until toll-free verification is APPROVED —
# a toll-free number cannot send to the US or Canada before then.
TWILIO_FROM_NUMBER=+18005550123

# ── Twilio: Voice (softphone, cell bridge, inbound, voicemail drop) ─────────
# A Standard API key from Account → API keys & tokens. These are NOT the
# account SID/auth token: minting a Voice access token requires an API key.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=
# The TwiML App whose Voice Request URL points at voiceOutboundTwiml.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Outbound caller ID. Optional — falls back to TWILIO_FROM_NUMBER.
TWILIO_CALLER_ID=+18005550123

# ── Google Calendar (two-way sync) ──────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID →
# Web application. Enable the Google Calendar API on the project first.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override. Defaults to
# https://us-central1-the-1p-leadership.cloudfunctions.net/googleOAuthCallback
# which must be listed as an Authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=

# ── The automation tick (sequence steps, reminders, watch renewal) ──────────
# Any long random string, e.g. `openssl rand -hex 32`. Set it as a repository
# secret under this same name so the crm-tick workflow can authenticate.
CRM_TICK_SECRET=

# ── SendGrid inbound event webhook (optional) ───────────────────────────────
SENDGRID_WEBHOOK_KEY=

# ── Two-way email on the contact card ───────────────────────────────────────
# Outbound already works with the SendGrid key alone. These two switch on
# RECEIVING: a lead's reply landing on their contact card in the CRM.
#
# The subdomain whose MX record points at SendGrid Inbound Parse
# (mx.sendgrid.net, priority 10). It MUST be a subdomain — repointing the MX
# of the1pnation.com itself would take the real mailbox offline. Outbound CRM
# email carries Reply-To: reply+<companyId>.<contactId>@<this domain>, which is
# what routes each reply to the right contact with no guessing.
INBOUND_EMAIL_DOMAIN=reply.the1pnation.com
# Any long random string, e.g. `openssl rand -hex 32`. Inbound Parse does not
# sign its posts, so this token in the webhook URL is the only thing stopping
# anyone from forging a lead's reply into the CRM. The endpoint is fail-closed:
# with this unset, inbound email is rejected outright. Full setup in
# docs/email-setup.md.
INBOUND_EMAIL_TOKEN=

# ── Escape hatch ────────────────────────────────────────────────────────────
# Overrides the base URL the functions hand to Twilio and Google for
# callbacks. Only needed for a custom domain or an emulator run.
FUNCTIONS_BASE_URL=
