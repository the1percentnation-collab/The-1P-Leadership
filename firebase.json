{
    "hosting": {
          "public": "public",
          "ignore": [
                  "firebase.json",
                  "**/.*",
                  "**/node_modules/**"
          ],
          "rewrites": [
                  { "source": "/login",  "destination": "/login.html"  },
                  { "source": "/signup", "destination": "/signup.html" },
                  {
                            "source": "**",
                            "destination": "/index.html"
                  }
          ]
    },
    "firestore": {
          "rules": "firestore.rules",
          "indexes": "firestore.indexes.json"
    },
    "storage": {
          "rules": "storage.rules"
    },
    "functions": [
          {
                  "source": "functions",
                  "codebase": "default",
                  "runtime": "nodejs20"
          }
    ]
}
