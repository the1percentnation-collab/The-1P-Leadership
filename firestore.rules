rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner() { return isSignedIn() && request.auth.token.role == 'owner'; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Is the caller an admin of company `cid`? We read the company doc and check adminUids.
    function isCompanyAdmin(cid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(cid))
        && request.auth.uid in get(/databases/$(database)/documents/companies/$(cid)).data.adminUids;
    }

    // When an admin reads another user's top-level doc, we only allow reads if the user's
    // companyId matches a company the caller admins. We can't query here, so we compare to
    // the existing doc's companyId.
    function callerAdminsSameCompanyAs(userDocData) {
      return userDocData.companyId != null && isCompanyAdmin(userDocData.companyId);
    }

    // Restrict admin reads of user docs to metadata fields only (NOT progress/notes/capstone —
    // those live in subcollections and are separately denied below). This function is advisory:
    // subcollections are the real protection.
    // ────────────────────────────────────────────────────────────────

    // users/{uid}
    match /users/{uid} {
      // Read:
      //  - owner: always
      //  - self: always
      //  - admin: if the target user is in one of their companies
      allow get: if isOwner()
                 || isSelf(uid)
                 || (isSignedIn() && callerAdminsSameCompanyAs(resource.data));

      // Only the owner can list the full users collection. Admins read their roster via
      // companies/{cid}/members/{uid} (mirrored by the acceptInvite Cloud Function).
      // Owner tooling (owner.html) also uses this to look up uid-by-email.
      // Leaderboard reads happen server-side via the `getLeaderboard` callable.
      allow list: if isOwner();

      // Write:
      //  - owner: always
      //  - self: can create/update own doc (role/companyId writes by self are allowed at signup;
      //          the Cloud Function enforces invite-driven role/companyId writes)
      //          BUT self may not write the leaderboard mirror fields; those are server-only.
      allow create: if isOwner() || (isSelf(uid)
                     && (!('statsPoints' in request.resource.data)
                         || request.resource.data.statsPoints == 0)
                     && (!('statsWeekPoints' in request.resource.data)
                         || request.resource.data.statsWeekPoints == 0)
                     && (!('unreadNotifCount' in request.resource.data)
                         || request.resource.data.unreadNotifCount == 0));
      allow update: if isOwner() || (isSelf(uid)
                     && request.resource.data.get('statsPoints', 0) == resource.data.get('statsPoints', 0)
                     && request.resource.data.get('statsWeekPoints', 0) == resource.data.get('statsWeekPoints', 0)
                     && request.resource.data.get('unreadNotifCount', 0) == resource.data.get('unreadNotifCount', 0));
      allow delete: if isOwner();

      // users/{uid}/progress/{moduleId} — STRICTLY private to the user (and owner).
      match /progress/{moduleId} {
        allow read, write: if isOwner() || isSelf(uid);
      }

      // users/{uid}/capstone — same.
      match /capstone/{docId=**} {
        allow read, write: if isOwner() || isSelf(uid);
      }

      // users/{uid}/stats/{statId} (Phase 2 leaderboard) — server-only writes.
      // Reads are permitted to any signed-in user so client-side leaderboard
      // panels can hydrate level badges via the getLeaderboard callable's
      // returned uids. (The callable itself uses Admin SDK and bypasses rules.)
      match /stats/{statId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // users/{uid}/notifications/{notifId} (Phase 3) — per-user inbox.
      // Server fan-out (Admin SDK) creates notifications when someone likes,
      // comments on, or @mentions the user. Self can mark them read; only
      // self/owner can read or delete.
      match /notifications/{notifId} {
        allow read: if isOwner() || isSelf(uid);
        allow create: if false;
        // Self may mark a notification read (or unread). All other fields
        // must be unchanged.
        allow update: if isSelf(uid)
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.get('commentId', null) == resource.data.get('commentId', null)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('preview', '') == resource.data.get('preview', '')
          && request.resource.data.get('fromName', '') == resource.data.get('fromName', '')
          && request.resource.data.get('fromAvatar', null) == resource.data.get('fromAvatar', null);
        allow delete: if isOwner() || isSelf(uid);
      }

      // users/{uid}/registrations/{eventId} — a per-member mirror of the
      // events they've registered for, written by the registerForEvent Cloud
      // Function (Admin SDK). Self/owner read; server-only writes.
      match /registrations/{eventId} {
        allow read: if isOwner() || isSelf(uid);
        allow write: if false;
      }
    }

    // companies/{companyId}
    match /companies/{cid} {
      // Reads: owner, or any admin in adminUids, or members whose companyId == cid (so
      // employees can see basic company info like name/seatCount).
      allow get: if isOwner()
                 || (isSignedIn() && request.auth.uid in resource.data.adminUids)
                 || (isSignedIn()
                     && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid);

      allow list: if isOwner();

      // Create/delete: owner only.
      allow create, delete: if isOwner();

      // Update: owner, or an admin currently in adminUids. Admins cannot change adminUids.
      allow update: if isOwner()
                    || (isSignedIn()
                        && request.auth.uid in resource.data.adminUids
                        && request.resource.data.adminUids == resource.data.adminUids);

      // companies/{cid}/invites/{inviteId} — readable by anyone (so new signups can look up by
      // code); writable by company admins and owner. Cloud Function mutates on accept.
      match /invites/{inviteId} {
        allow read: if true;
        allow create, update, delete: if isOwner() || isCompanyAdmin(cid);
      }

      // companies/{cid}/members/{uid} — mirrored roster entries written by the
      // acceptInvite Cloud Function. Readable by owner + any admin of the company
      // + any member of the same company (so members.html can render peers).
      // Members can read their own entry. Writes are server-only (admin SDK bypasses rules).
      match /members/{mUid} {
        allow read: if isOwner()
                     || isCompanyAdmin(cid)
                     || (isSignedIn() && request.auth.uid == mUid)
                     || (isSignedIn()
                         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid);
        allow list: if isOwner()
                     || isCompanyAdmin(cid)
                     || (isSignedIn()
                         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid);
        // Allow the company admin/owner to delete a member entry when revoking a seat.
        allow delete: if isOwner() || isCompanyAdmin(cid);
        // Owner can write freely; members can update their own aggregate digest fields
        // (completedCount, lastActiveAt, capstoneStatus) but not reassign their uid.
        allow create, update: if isOwner()
                               || (isSignedIn() && request.auth.uid == mUid);
      }

      // ──────────────────────────────────────────────────────────────
      // CRM (Phase 2): contacts + notes + activities.
      // Scoped to the company. Only company admins + owner can read/write.
      // Activities are create-only from the client (immutable audit trail).
      // ──────────────────────────────────────────────────────────────
      match /contacts/{contactId} {
        allow read: if isOwner() || isCompanyAdmin(cid);
        allow create, update, delete: if isOwner() || isCompanyAdmin(cid);

        match /notes/{noteId} {
          allow read: if isOwner() || isCompanyAdmin(cid);
          allow create: if (isOwner() || isCompanyAdmin(cid))
                         && request.resource.data.authorUid == request.auth.uid;
          allow update: if (isOwner() || isCompanyAdmin(cid))
                         && resource.data.authorUid == request.auth.uid
                         && request.resource.data.authorUid == resource.data.authorUid;
          allow delete: if isOwner() || isCompanyAdmin(cid);
        }

        match /activities/{activityId} {
          allow read: if isOwner() || isCompanyAdmin(cid);
          // Create-only: act as immutable audit trail. actorUid must match caller.
          allow create: if (isOwner() || isCompanyAdmin(cid))
                         && request.resource.data.actorUid == request.auth.uid;
          allow update: if false;
          // Deletes only by owner — admins cannot tamper with history.
          allow delete: if isOwner();
        }
      }

      // ──────────────────────────────────────────────────────────────
      // Campaigns (Phase 3): email broadcasts + per-event telemetry.
      // ──────────────────────────────────────────────────────────────
      match /campaigns/{campaignId} {
        allow read: if isOwner() || isCompanyAdmin(cid);
        allow create, update, delete: if isOwner() || isCompanyAdmin(cid);

        // Events subcollection — written by the webhook via Admin SDK (bypasses rules).
        // Clients get read access only.
        match /events/{eventId} {
          allow read: if isOwner() || isCompanyAdmin(cid);
          allow write: if false;
        }
      }
    }

    // ────────────────────────────────────────────────────────────────
    // Community feed
    // ────────────────────────────────────────────────────────────────
    // posts/{postId}
    //  Scope: companyId == null  -> global (owner-authored, visible to all)
    //         companyId == <cid>  -> company-scoped, visible to that company + owner
    match /posts/{postId} {
      // Can the caller see this post?
      function callerCompanyId() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
               ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
               : null;
      }
      function canReadPost() {
        return isSignedIn() && (
          isOwner()
          || resource.data.companyId == null
          || resource.data.companyId == callerCompanyId()
        );
      }

      allow get: if canReadPost();
      // list: we can't evaluate resource.data per-query here across companyId == null OR ==
      // user's cid easily; clients run two queries (one per companyId filter). Allow list to
      // any signed-in user — individual documents still filter via `get` rules above.
      allow list: if isSignedIn();

      // Create: authorUid must match auth.uid. Counters must start at 0. companyId must be
      // null (global) only if the caller is owner, otherwise it must match caller's own cid.
      // Category (Phase 1 channels) must be one of the allowed enum values when present.
      // mentionedUids (Phase 3) must be a list of strings, capped at 10 to bound trigger fan-out.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && (
          !('category' in request.resource.data)
          || request.resource.data.category in ['general','wins','questions','announcements']
        )
        && (!('pinned' in request.resource.data) || request.resource.data.pinned == false)
        && (
          !('mentionedUids' in request.resource.data)
          || (request.resource.data.mentionedUids is list
              && request.resource.data.mentionedUids.size() <= 10)
        )
        && (
          (request.resource.data.companyId == null && isOwner())
          || (request.resource.data.companyId != null
              && request.resource.data.companyId == callerCompanyId())
        );

      // Update:
      //   - author may update their own post (text, imageUrl, category, updatedAt) but not counters or `pinned`
      //   - any signed-in reader may increment/decrement likeCount by ±1 (via toggleLike txn)
      //   - any signed-in reader may increment/decrement commentCount by ±1 (via addComment txn)
      //   - owner or same-company admin may flip `pinned` (and only `pinned`); counters/content unchanged.
      // We enforce ±1 delta on counters; content edits only if authorUid matches.
      allow update: if isSignedIn() && canReadPost() && (
        (
          // Like toggle: likeCount diffs by ±1, commentCount & content unchanged.
          request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.text == resource.data.text
          && request.resource.data.imageUrl == resource.data.imageUrl
          && request.resource.data.commentCount == resource.data.commentCount
          && request.resource.data.get('category', null) == resource.data.get('category', null)
          && request.resource.data.get('pinned', false) == resource.data.get('pinned', false)
          && request.resource.data.get('mentionedUids', []) == resource.data.get('mentionedUids', [])
          && (
            request.resource.data.likeCount == resource.data.likeCount + 1
            || request.resource.data.likeCount == resource.data.likeCount - 1
          )
        )
        || (
          // Comment add/delete: commentCount diffs by ±1, likeCount & content unchanged.
          request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.text == resource.data.text
          && request.resource.data.imageUrl == resource.data.imageUrl
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.get('category', null) == resource.data.get('category', null)
          && request.resource.data.get('pinned', false) == resource.data.get('pinned', false)
          && request.resource.data.get('mentionedUids', []) == resource.data.get('mentionedUids', [])
          && (
            request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1
          )
        )
        || (
          // Author editing own post content — counters and `pinned` unchanged. Category and
          // mentionedUids may change (treated as content edits); category stays in enum, and
          // mentionedUids stays a list capped at 10.
          resource.data.authorUid == request.auth.uid
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.commentCount == resource.data.commentCount
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.get('pinned', false) == resource.data.get('pinned', false)
          && (
            !('category' in request.resource.data)
            || request.resource.data.category in ['general','wins','questions','announcements']
          )
          && (
            !('mentionedUids' in request.resource.data)
            || (request.resource.data.mentionedUids is list
                && request.resource.data.mentionedUids.size() <= 10)
          )
        )
        || (
          // Moderator pinning — owner or same-company admin may flip `pinned` only.
          // Everything else (counters, content, scope, category, mentions) must be unchanged.
          (isOwner() || (resource.data.companyId != null && isCompanyAdmin(resource.data.companyId)))
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.text == resource.data.text
          && request.resource.data.imageUrl == resource.data.imageUrl
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.commentCount == resource.data.commentCount
          && request.resource.data.get('category', null) == resource.data.get('category', null)
          && request.resource.data.get('mentionedUids', []) == resource.data.get('mentionedUids', [])
        )
      );

      // Delete: author, owner, or same-company admin.
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || isOwner()
        || (resource.data.companyId != null && isCompanyAdmin(resource.data.companyId))
      );

      // comments/{commentId}
      match /comments/{commentId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId));
        }
        function callerCompanyId() {
          return exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
                 : null;
        }
        function canReadParent() {
          return isSignedIn() && (
            isOwner()
            || parentPost().data.companyId == null
            || parentPost().data.companyId == callerCompanyId()
          );
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && canReadParent()
          && request.resource.data.authorUid == request.auth.uid
          && (
            !('mentionedUids' in request.resource.data)
            || (request.resource.data.mentionedUids is list
                && request.resource.data.mentionedUids.size() <= 10)
          );
        allow update: if isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && (
            !('mentionedUids' in request.resource.data)
            || (request.resource.data.mentionedUids is list
                && request.resource.data.mentionedUids.size() <= 10)
          );
        allow delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid
          || isOwner()
          || (parentPost().data.companyId != null && isCompanyAdmin(parentPost().data.companyId))
        );
      }

      // likes/{uid} — doc id must equal auth.uid.
      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == likeUid;
        allow update: if false;
      }
    }

    // ────────────────────────────────────────────────────────────────
    // Channels (Phase 1) — categories for the community feed.
    // Doc id == channel key (e.g. 'general', 'wins'). Owner-only writes;
    // any signed-in user may read so the sidebar can render the list.
    // ────────────────────────────────────────────────────────────────
    match /channels/{key} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner();
    }

    // ────────────────────────────────────────────────────────────────
    // Community invite tokens. Server-only — clients reach them via
    // the createCommunityInvite / acceptCommunityInvite callables.
    // Tokens are sensitive (anyone with one can be tied to your account
    // on signup), so the collection is invisible to clients.
    // ────────────────────────────────────────────────────────────────
    match /communityInvites/{tokenId} {
      allow read, write: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // Events (Stage 4) — community events visible to any signed-in
    // user; owner / company-admin can create / update / delete.
    // No field-level validation in v1; the events-page UI gates input.
    // ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      // Public read: events are front-facing so anyone (signed in or not) can
      // view them and register from the public Events page.
      allow read: if true;
      allow create, update, delete: if isOwner()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Registrations — written only by the registerForEvent Cloud Function
      // (Admin SDK). Readable by organizers (owner/admin) to see attendance;
      // attendee PII is not exposed to the general public.
      match /registrations/{regId} {
        allow read: if isOwner()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow write: if false;
      }
    }
  }
}













