rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors firestore.rules isAnyAdmin(): owner custom claim OR
    // users/{uid}.role == 'admin' (cross-service Firestore lookup).
    function isCourseAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'owner' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Course files (videos, attachments) are for people enrolled in the
    // course. users/{uid}.enrolledCourseSlugs is Admin-SDK-only in
    // firestore.rules, written by checkout, comps and admin grants. The
    // player streams the tokened URL saved on the lesson when it was
    // uploaded, so learners never need a rules-checked read; this stops a
    // free account from listing a paid course's folder and pulling every
    // file with getDownloadURL.
    function isEnrolledInCourse(slug) {
      return request.auth != null
        && slug in firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.get('enrolledCourseSlugs', []);
    }

    // courses/{slug}/images — inline lesson images inserted via the course
    // builder's editor. Shown to members (and on public sales pages), so
    // reads are public like product-images.
    match /courses/{slug}/images/{fileName} {
      allow read: if true;
      allow write: if isCourseAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // courses/{slug}/attachments — downloadable lesson resources
    // (PDFs, docs, slides, sheets, zips, audio, images).
    match /courses/{slug}/attachments/{fileName} {
      allow read: if isCourseAdmin() || isEnrolledInCourse(slug);
      allow write: if isCourseAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\..*|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint|text/csv|text/plain|application/zip|application/x-zip-compressed|image/.*|audio/.*');
    }

    // courses/{slug}/videos — uploaded lesson videos played via a native
    // <video> tag in the course player.
    match /courses/{slug}/videos/{fileName} {
      allow read: if isCourseAdmin() || isEnrolledInCourse(slug);
      allow write: if isCourseAdmin()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|webm)');
    }

    // books/{bookId}/{fileName} — the digital library. The cover is public
    // (library shelf, sales pages). Everything else, the EPUB above all, is
    // readable only by someone whose users/{uid}.ownedBookIds lists the book.
    // That field is Admin-SDK-only (firestore.rules), set by checkout and
    // grants through a course's grantsBooks. The reader fetches with
    // getBlob(), never a download URL, so there is no token link to share.
    match /books/{bookId}/{fileName} {
      allow read: if fileName.matches('cover\\.(jpg|jpeg|png|webp)')
                  || isCourseAdmin()
                  || (request.auth != null
                      && bookId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
                           .data.get('ownedBookIds', []));
      // Audiobook chapters (audio-01.mp3, ...) are far bigger than an EPUB,
      // so they get their own ceiling and their own file names.
      allow write: if isCourseAdmin()
                   && ((request.resource.size < 50 * 1024 * 1024
                        && request.resource.contentType.matches('application/epub\\+zip|image/(jpeg|png|webp)'))
                       || (fileName.matches('audio-[0-9]{2,3}\\.(mp3|m4a|m4b|aac)')
                           && request.resource.size < 300 * 1024 * 1024
                           && request.resource.contentType.matches('audio/(mpeg|mp3|mp4|x-m4a|m4a|aac|x-m4b)')));
    }

    // companies/{cid}/voicemails/{fileName} — prerecorded voicemail greetings
    // for the dialer's one-click drop. Never read by the browser: Twilio
    // fetches the audio through the voicemailAudio function, which checks a
    // server-written token. So reads are closed outright and only admins
    // (the same role that can use the CRM) may upload.
    match /companies/{cid}/voicemails/{fileName} {
      allow read: if false;
      allow write: if isCourseAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // auditScorecards/{id}/{fileName} — a client's logo for their Alignment
    // Scorecard. Owner only, like the scorecard itself; the builder shows it
    // through the download URL it saved.
    match /auditScorecards/{scorecardId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.role == 'owner';
      allow delete: if request.auth != null && request.auth.token.role == 'owner';
      allow create, update: if request.auth != null && request.auth.token.role == 'owner'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp|svg\\+xml)');
    }

    // avatars/{uid}/{filename} — readable by any signed-in user, writable only by that uid.
    match /avatars/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // posts/{postId}/{filename} — readable by any signed-in user. Writable by any signed-in
    // user (the client attaches the postId after creating the post doc, which is itself
    // guarded by Firestore rules tying authorUid to auth.uid). Extra hardening (5MB, images)
    // is applied here.
    match /posts/{postId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // events/{eventId}/{filename} — flyer/cover images. Readable by any signed-in
    // user; writable by any signed-in user (the event doc write is owner/admin-gated
    // by Firestore rules). Hardened to images under 10MB.
    match /events/{eventId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // product-images/{uid}/{filename} — product covers shown on the PUBLIC
    // /upcoming page, so reads are public. Writable by any signed-in user
    // (the product doc itself is admin/owner-gated by Firestore rules).
    match /product-images/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // announcement-images/{uid}/{filename} — cover art for dashboard
    // spotlight slides. Readable by any signed-in user (the dashboard is
    // behind auth); writable by any signed-in user, since the announcement
    // doc itself is admin/owner-gated by Firestore rules — same trade the
    // product and event image paths already make.
    match /announcement-images/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // bug-screenshots/{filename} — written by the reportBug Cloud Function
    // (Admin SDK). No client read or write; owner access is via signed URLs
    // generated server-side and included in the email notification.
    match /bug-screenshots/{filename} {
      allow read, write: if false;
    }
  }
}
